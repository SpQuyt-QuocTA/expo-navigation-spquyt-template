{
  "name": "expo-navigation-spquyt-template",
  "version": "1.0.0",
  "scripts": {
    "start": "npx expo start",
    "start:dev": "APP_ENV=development npx expo start",
    "start:staging": "APP_ENV=staging npx expo start",
    "start:prod": "APP_ENV=production npx expo start",
    "android:dev": "APP_ENV=development npx expo run:android --device",
    "android:staging": "APP_ENV=staging npx expo run:android --device",
    "android:prod": "APP_ENV=production npx expo run:android --device",
    "ios:dev": "APP_ENV=development npx expo run:ios --device",
    "ios:staging": "APP_ENV=staging npx expo run:ios --device",
    "ios:prod": "APP_ENV=production npx expo run:ios --device",
    "prebuild:dev": "APP_ENV=development npx expo prebuild --clean && test -d android && echo \"sdk.dir=$HOME/Library/Android/sdk\" > android/local.properties || echo 'Done'",
    "prebuild:staging": "APP_ENV=staging npx expo prebuild --clean && test -d android && echo \"sdk.dir=$HOME/Library/Android/sdk\" > android/local.properties || echo 'Done'",
    "prebuild:prod": "APP_ENV=production npx expo prebuild --clean && test -d android && echo \"sdk.dir=$HOME/Library/Android/sdk\" > android/local.properties || echo 'Done'",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "npx expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.27",
    "expo": "^54.0.0",
    "expo-constants": "^18.0.9",
    "expo-dev-client": "~6.0.15",
    "expo-localization": "~17.0.7",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.6.0",
    "nativewind": "4.1.21",
    "react": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.14.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "dotenv": "^17.2.3",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-native-svg-transformer": "^1.5.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true
}
